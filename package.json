{
  "name": "notelens",
  "version": "2.9.1",
  "description": "NoteLens Canvas: Pizarra infinita inteligente para Obsidian con lápiz óptico, etiquetas OneNote, PDFs y vídeos.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "deploy": "node esbuild.config.mjs production --deploy",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-core-tests.mjs",
    "devices": "node dev-harness/run-devices.mjs",
    "validate": "node scripts/validate-release.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run validate",
    "release:check": "npm run check && node scripts/audit-dependencies.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "test:mobile": "node dev-harness/run76.mjs && node dev-harness/run77.mjs"
  },
  "keywords": [
    "obsidian",
    "onenote",
    "canvas",
    "stylus",
    "draw",
    "pdf",
    "video"
  ],
  "author": "JotaTito",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "fflate": "^0.8.3",
    "jspdf": "4.2.1",
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "0.28.2",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0"
  }
}
